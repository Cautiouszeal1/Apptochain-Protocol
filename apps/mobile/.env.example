# Copy to .env. EXPO_PUBLIC_* values are bundled into the app, so they are public by design.
# Free project ID from https://dashboard.reown.com (WalletConnect)
EXPO_PUBLIC_REOWN_PROJECT_ID=
EXPO_PUBLIC_RELAYER_URL=https://apptochain-relayer.onrender.com
EXPO_PUBLIC_FACTORY_ADDRESS=0x2bD0b6DC3E47c199510c399076fF18356a768cd5
EXPO_PUBLIC_FORWARDER_ADDRESS=0xb04971fcB54192613eE45249390B653E2B0D4963
# From your dashboard → API keys. It only sponsors YOUR modules and is rate-limited.
EXPO_PUBLIC_ATC_API_KEY=
# From your dashboard → Modules
EXPO_PUBLIC_MEMBERSHIP_ADDRESS=
EXPO_PUBLIC_REWARDS_ADDRESS=
