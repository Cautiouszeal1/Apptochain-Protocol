# Copy to .env and fill in. NEVER commit .env.
PORT=8787
RPC_URL=https://sepolia.base.org
# Hot wallet that pays gas. Keep only a small ETH float on it.
RELAYER_PRIVATE_KEY=0x...
# From packages/contracts/deployments/<network>.json
FORWARDER_ADDRESS=0x...
FACTORY_ADDRESS=0x...

# Optional: require API keys. Format appId:key,appId2:key2  (empty = open sandbox)
API_KEYS=
# Comma-separated allowed browser origins (empty = allow all, fine for alpha only)
CORS_ORIGINS=
# Abuse limits
MAX_GAS_PER_REQUEST=600000
RATE_LIMIT_PER_MINUTE=10
DAILY_QUOTA_PER_APP=1000
LOW_BALANCE_ETH=0.005
LOG_FILE=relay-log.jsonl
