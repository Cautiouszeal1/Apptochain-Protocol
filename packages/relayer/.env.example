# Copy to .env and fill in. NEVER commit .env.
PORT=8787
RPC_URL=https://sepolia.base.org
# Hot wallet that pays gas. Use a dedicated wallet with only a small ETH float.
RELAYER_PRIVATE_KEY=0x...
# From packages/contracts/deployments/<network>.json
FORWARDER_ADDRESS=0x...
FACTORY_ADDRESS=0x...

# ── Builder dashboard (Phase 3) ──
# Postgres connection string (e.g. Supabase → Connect → Session pooler). Empty = in-memory (resets on restart).
DATABASE_URL=
# Random string, 32+ characters. Signs dashboard sessions. Generate: openssl rand -hex 32
SESSION_SECRET=
# Allow requests without an API key (the public sandbox demo). Set false once builders use keys.
ALLOW_SANDBOX=true

# Optional static keys (format appId:key,appId2:key2). Dashboard keys are preferred.
API_KEYS=
# Comma-separated allowed browser origins (demo + dashboard). Empty = allow all.
CORS_ORIGINS=

# ── Abuse limits and safety ──
MAX_GAS_PER_REQUEST=600000
# Refuse to relay when network fees exceed this (gwei). Empty = no ceiling.
MAX_GAS_PRICE_GWEI=
RATE_LIMIT_PER_MINUTE=10
DAILY_QUOTA_PER_APP=1000
LOW_BALANCE_ETH=0.005
# Optional webhook for low-balance alerts (Slack / Discord incoming webhook URL)
ALERT_WEBHOOK_URL=
LOG_FILE=relay-log.jsonl
